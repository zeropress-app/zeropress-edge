{
  // Replace every placeholder with your installation values.
  "name": "<your-edge-worker-name>",
  "d1_databases": [
    {
      "binding": "EDGE_DB",
      "database_name": "<your-edge-database-name>"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EDGE_KV",
      "id": "<your-edge-kv-namespace-id>"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "<your-mail-queue-name>"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "COMMENT_READ_RATE_LIMITER",
      "namespace_id": "<your-comment-read-namespace-id>"
    },
    {
      "name": "COMMENT_WRITE_RATE_LIMITER",
      "namespace_id": "<your-comment-write-namespace-id>"
    },
    {
      "name": "COMMENT_CHALLENGE_RATE_LIMITER",
      "namespace_id": "<your-comment-challenge-namespace-id>"
    },
    {
      "name": "NEWSLETTER_READ_RATE_LIMITER",
      "namespace_id": "<your-newsletter-read-namespace-id>"
    },
    {
      "name": "NEWSLETTER_SUBSCRIBE_RATE_LIMITER",
      "namespace_id": "<your-newsletter-subscribe-namespace-id>"
    },
    {
      "name": "NEWSLETTER_CHALLENGE_RATE_LIMITER",
      "namespace_id": "<your-newsletter-challenge-namespace-id>"
    },
    {
      "name": "FORM_READ_RATE_LIMITER",
      "namespace_id": "<your-form-read-namespace-id>"
    },
    {
      "name": "FORM_SUBMIT_RATE_LIMITER",
      "namespace_id": "<your-form-submit-namespace-id>"
    },
    {
      "name": "FORM_CHALLENGE_RATE_LIMITER",
      "namespace_id": "<your-form-challenge-namespace-id>"
    }
  ]
}
