{
  // Synthetic resource identities for package CI builds only. Never deploy
  // this config or use it as an installation template.
  "name": "zeropress-edge-ci",
  "d1_databases": [
    {
      "binding": "EDGE_DB",
      "database_name": "zeropress-edge-ci",
      "remote": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EDGE_KV",
      "id": "11111111111111111111111111111111",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "zeropress-edge-ci-mail",
        "remote": false
      }
    ]
  },
  "ratelimits": [
    { "name": "COMMENT_READ_RATE_LIMITER", "namespace_id": "700001" },
    { "name": "COMMENT_WRITE_RATE_LIMITER", "namespace_id": "700002" },
    { "name": "COMMENT_CHALLENGE_RATE_LIMITER", "namespace_id": "700003" },
    { "name": "NEWSLETTER_READ_RATE_LIMITER", "namespace_id": "700004" },
    { "name": "NEWSLETTER_SUBSCRIBE_RATE_LIMITER", "namespace_id": "700005" },
    { "name": "NEWSLETTER_CHALLENGE_RATE_LIMITER", "namespace_id": "700006" },
    { "name": "FORM_READ_RATE_LIMITER", "namespace_id": "700007" },
    { "name": "FORM_SUBMIT_RATE_LIMITER", "namespace_id": "700008" },
    { "name": "FORM_CHALLENGE_RATE_LIMITER", "namespace_id": "700009" }
  ]
}
